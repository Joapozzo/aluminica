{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Aluminica Identity v0.1",
    "status": "provisional",
    "paletteStatus": "Awaiting exact values from the existing brand manual.",
    "replacementPolicy": "Replace values here; consumers use semantic token paths only."
  },
  "color": {
    "palette": {
      "mineral50": { "$value": "#F4F3EF", "$type": "color" },
      "mineral100": { "$value": "#E8E7E2", "$type": "color" },
      "mineral300": { "$value": "#B8BDB9", "$type": "color" },
      "mineral500": { "$value": "#666D69", "$type": "color" },
      "mineral700": { "$value": "#343A37", "$type": "color" },
      "mineral850": { "$value": "#171B19", "$type": "color" },
      "mineral950": { "$value": "#0B0E0D", "$type": "color" },
      "brandBlue": { "$value": "#165DFF", "$type": "color", "$description": "Provisional blue based on the client preference; replace with the brand manual value." },
      "brandSky": { "$value": "#75C8FF", "$type": "color", "$description": "Provisional supporting light blue; not intended for body text." },
      "signal": { "$value": "{color.palette.brandBlue}", "$type": "color" },
      "signalInk": { "$value": "#FFFFFF", "$type": "color" }
    },
    "light": {
      "surface": {
        "canvas": { "$value": "{color.palette.mineral50}", "$type": "color" },
        "raised": { "$value": "#FFFFFF", "$type": "color" },
        "subtle": { "$value": "{color.palette.mineral100}", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{color.palette.mineral950}", "$type": "color" },
        "secondary": { "$value": "{color.palette.mineral700}", "$type": "color" },
        "muted": { "$value": "{color.palette.mineral500}", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "#D2D4D0", "$type": "color" },
        "strong": { "$value": "{color.palette.mineral700}", "$type": "color" }
      },
      "action": {
        "primary": { "$value": "{color.palette.signal}", "$type": "color" },
        "onPrimary": { "$value": "{color.palette.signalInk}", "$type": "color" },
        "focus": { "$value": "{color.palette.mineral950}", "$type": "color" }
      }
    },
    "dark": {
      "surface": {
        "canvas": { "$value": "{color.palette.mineral950}", "$type": "color" },
        "raised": { "$value": "{color.palette.mineral850}", "$type": "color" },
        "subtle": { "$value": "#222825", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{color.palette.mineral50}", "$type": "color" },
        "secondary": { "$value": "{color.palette.mineral300}", "$type": "color" },
        "muted": { "$value": "#929A95", "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "#343B37", "$type": "color" },
        "strong": { "$value": "{color.palette.mineral300}", "$type": "color" }
      },
      "action": {
        "primary": { "$value": "{color.palette.signal}", "$type": "color" },
        "onPrimary": { "$value": "{color.palette.signalInk}", "$type": "color" },
        "focus": { "$value": "{color.palette.mineral50}", "$type": "color" }
      }
    }
  },
  "font": {
    "display": {
      "$value": ["Archivo Narrow", "Arial Narrow", "Helvetica Neue", "Arial", "sans-serif"],
      "$type": "fontFamily",
      "$description": "Condensed display face for headlines."
    },
    "body": {
      "$value": ["Manrope", "Helvetica Neue", "Arial", "sans-serif"],
      "$type": "fontFamily",
      "$description": "Body and secondary UI text."
    },
    "data": {
      "$value": ["Aluminica Data Placeholder", "IBM Plex Mono", "monospace"],
      "$type": "fontFamily",
      "$description": "Optional role for measures and compact metadata."
    }
  },
  "radius": {
    "technical": { "$value": "2px", "$type": "dimension" },
    "component": { "$value": "12px", "$type": "dimension" },
    "media": { "$value": "24px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "0ms", "$type": "duration" },
      "fast": { "$value": "160ms", "$type": "duration" },
      "base": { "$value": "320ms", "$type": "duration" },
      "slow": { "$value": "640ms", "$type": "duration" },
      "scene": { "$value": "1000ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier" },
      "enter": { "$value": [0.16, 1, 0.3, 1], "$type": "cubicBezier" },
      "exit": { "$value": [0.7, 0, 0.84, 0], "$type": "cubicBezier" }
    }
  }
}
